rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function verified() { return signedIn() && request.auth.token.email_verified == true; }
    match /users/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['nickname','privacyAccepted','createdAt'])
        && request.resource.data.privacyAccepted == true;
    }
    match /codes/{code} {
      allow get: if verified();
      allow update: if verified()
        && resource.data.usedBy == null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedBy','usedAt'])
        && request.resource.data.usedBy == request.auth.uid
        && request.resource.data.usedAt == request.time;
    }
    match /entitlements/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow create: if verified() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['active','code','createdAt'])
        && request.resource.data.active == true
        && get(/databases/$(database)/documents/codes/$(request.resource.data.code)).data.usedBy == null
        && getAfter(/databases/$(database)/documents/codes/$(request.resource.data.code)).data.usedBy == uid;
    }
    match /downloads/{n} {
      allow read: if verified()
        && get(/databases/$(database)/documents/entitlements/$(request.auth.uid)).data.active == true;
    }
  }
}
